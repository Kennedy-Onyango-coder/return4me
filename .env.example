# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: the TCP port the HTTP server listens on. Optional.
#
# PHASE 10 (F-1). Leave this unset for local development: the server then uses
# its long-standing default of 3000, so nothing about `npm run dev` changes.
#
# Set it when the hosting platform assigns the port. Managed container platforms
# (Cloud Run, and equivalents) inject PORT and route traffic and health checks to
# the port they assigned, so the server must listen on that exact port. A deploy
# that ignores it can look like it booted healthily while serving no traffic.
#
# Validation is strict, and a bad value can never take the service down: the
# value must be a whole number from 1 to 65535 with nothing else in it. Anything
# else — "abc", "-1", "0", "65536", "1.5", "3000xyz", or a value with stray
# whitespace — is rejected, and the server falls back to 3000 while logging a
# warning naming the rejected value. Port 0 is rejected on purpose: it asks the
# OS for a random ephemeral port, which is never the address users or health
# checks would reach this server on.
PORT="3000"

# JWT_SECRET: Salt for signing OTP session tokens safely
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_VALUE_MIN_32_CHARS"

# ADMIN_PASSCODE: Password to access the Return4me administration console
ADMIN_PASSCODE="REPLACE_WITH_STRONG_PASSCODE_MIN_12_CHARS"

# INTASEND API CONFIGURATION (SANDBOX OR PRODUCTION)
INTASEND_PUBLISHABLE_KEY="REPLACE_WITH_INTASEND_PUBLISHABLE_KEY"
INTASEND_SECRET_KEY="REPLACE_WITH_INTASEND_SECRET_KEY"
INTASEND_WEBHOOK_SECRET="REPLACE_WITH_INTASEND_WEBHOOK_SECRET"

# DOC_HASH_SALT: Salt for hashing document numbers and national IDs via HMAC-SHA256
DOC_HASH_SALT="REPLACE_WITH_STRONG_RANDOM_VALUE_MIN_32_CHARS"

# DISPUTE_WINDOW_HOURS: how long a claim sits in 'pending_settlement' (item
# already physically handed over, payout booked in the ledger as pending)
# before the settlement sweep actually disburses the M-Pesa split. Gives a
# real window for a second claimant, the owner, or an admin to freeze a
# suspicious handover before money moves. Defaults to 48 if unset.
DISPUTE_WINDOW_HOURS="48"

# S3 COMPATIBLE STORAGE CONFIGURATION (e.g. Backblaze B2 or AWS S3)
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_KEY=""
STORAGE_SECRET=""

# CORS_ORIGIN: Allowed origin for CORS
CORS_ORIGIN="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string with SSL mode required for Neon/Supabase
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# The following four variables are used only by Drizzle Kit's migration/introspection
# tooling (src/db/drizzle.config.ts), as an alternative to parsing DATABASE_URL directly.
# Not required for running the app itself — only needed if running `drizzle-kit` commands locally.
SQL_HOST="REPLACE_WITH_DB_HOST"
SQL_DB_NAME="REPLACE_WITH_DB_NAME"
SQL_ADMIN_USER="REPLACE_WITH_DB_USER"
SQL_ADMIN_PASSWORD="REPLACE_WITH_DB_PASSWORD"

# GROQ_API_KEY: Optional free API key for secondary OCR provider (Groq Vision,
# used only if Gemini fails/is unconfigured). Free tier, no card required —
# get one at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# AFRICA'S TALKING SMS SERVICE CONFIGURATION
AFRICASTALKING_API_KEY="REPLACE_WITH_AFRICASTALKING_API_KEY"
AFRICASTALKING_USERNAME="REPLACE_WITH_AFRICASTALKING_USERNAME"
AFRICASTALKING_SENDER_ID="REPLACE_WITH_AFRICASTALKING_SENDER_ID"

# SMS_ENABLED: the switch that actually allows LIVE SMS to be dispatched.
# Defaults to disabled when unset — set it to exactly "true" to enable dispatch.
#
# PHASE 10 (F-3). This flag was previously used by the SMS layer but documented
# nowhere, which is a dangerous omission in the direction that matters: the
# credentials above are enough to make a deployment LOOK fully configured, so an
# operator could set all three AFRICASTALKING_* variables, deploy, and get zero
# delivered messages without any error. Both the pickup code that releases an
# item and the phone-verification OTP travel by SMS, so a silent miss here stops
# real people from collecting real belongings.
#
# It is a deliberate second gate, not a duplicate of the credentials: it lets a
# deployment hold valid provider credentials while keeping live sending off
# (staging, demos, cost control) without stripping secrets from the environment.
#
# Behaviour when it is NOT "true" (or the credentials are missing/placeholder):
#   development/test -> the message is printed to the server console with an
#                       explicit "SIMULATION" label, and the only code path that
#                       ever logs a real code. Nothing leaves the machine.
#   production       -> sending FAILS CLOSED: the send reports failure so the
#                       caller is never told an SMS went out when it did not.
# The platform never reports a delivery it cannot prove, in either case.
#
# Set to "true" only in a deployment that should actually send SMS to real
# phones, and only once the AFRICASTALKING_* values above are real.
SMS_ENABLED="false"

# RESEND EMAIL NOTIFICATION CONFIGURATION
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"
RESEND_FROM_EMAIL="onboarding@resend.dev"
ADMIN_NOTIFICATION_EMAIL="admin@return4me.co.ke"

# PER-ADMIN INITIAL ACCOUNT CONFIGURATION (FOR FIRST-BOOT AUTO-SEED)
ADMIN_INITIAL_USERNAME="return4me_admin"
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_ADMIN_PASSWORD"

# SENTRY ERROR TRACKING CONFIGURATION
SENTRY_DSN_BACKEND="REPLACE_WITH_SENTRY_DSN_BACKEND"
VITE_SENTRY_DSN_FRONTEND="REPLACE_WITH_VITE_SENTRY_DSN_FRONTEND"

# ALLOW_MOCK_OTP_BYPASS: Enables mock OTP bypass ('1234' or '4114') in non-production environments.
# Must be deliberately enabled for local testing/development convenience.
# Must NEVER be set to "true" in any real/production deployment.
ALLOW_MOCK_OTP_BYPASS="false"

# ENABLE_DEV_PAYMENT_SIMULATION: DEVELOPMENT/TEST ONLY. Not a production payment
# switch, and not a way to take or waive money. Leave it "false" everywhere else.
#
# PHASE 10 (F-4). This flag was previously used but documented nowhere. It is
# documented now precisely BECAUSE it is dangerous to enable: turning it on
# exposes POST /api/dev/simulate-payment/:claimId, which fabricates an
# authoritative payment confirmation for a claim — it moves the claim to
# escrow_held and stamps paid_at, the same state the real M-Pesa webhook
# produces, with NO money moving at all. It exists only so a developer can finish
# the payment flow through the browser when sandbox provider credentials mean no
# real STK push ever reaches a phone.
#
# It is deliberately NOT the only condition. The endpoint requires ALL THREE of:
#   1. NODE_ENV explicitly "development" or "test" — NOT unset, NOT production
#   2. ALLOW_MOCK_OTP_BYPASS      === "true"
#   3. ENABLE_DEV_PAYMENT_SIMULATION === "true"
# The money-specific flag is kept separate from the OTP bypass on purpose: a
# non-money convenience switch must never be able to fake a payment on its own.
#
# In addition, the server REFUSES TO BOOT when NODE_ENV=production and this is
# "true" (rather than merely ignoring it), so a deployment that sets it by
# mistake fails loudly instead of serving a fake payment endpoint. Outside that,
# the endpoint returns 404 and no payment is simulated.
ENABLE_DEV_PAYMENT_SIMULATION="false"

# GEOCODING (Phase 9D) — OPTIONAL, BEST-EFFORT, AND SAFE TO LEAVE OFF.
#
# Return4me uses forward geocoding for ONE non-critical purpose: estimating
# which held-item Agent hub is nearest to a reported found item, so the drop-off
# can be routed automatically. When it is unavailable the report is still
# accepted and the platform simply routes it to the manual assignment queue.
# Nothing about ownership, claiming, matching or payments depends on it.
#
# GEOCODING_PROVIDER: 'nominatim' (default) or 'none'/'off'/'disabled' to turn
#   geocoding off completely. When off, NO outbound request is ever made and the
#   whole platform continues to work. No API key is required either way.
# GEOCODING_ENDPOINT: the provider endpoint. Configurable so a provider can be
#   switched WITHOUT a code change (the current provider's usage policy
#   requires that its clients be able to switch away at any time).
# GEOCODING_TIMEOUT_MS: hard bound on each outbound call (default 2500). A
#   hung provider must never hold an application request open.
# GEOCODING_CACHE_TTL_MS: how long a successful lookup is reused (default
#   86400000 = 24h). Caching is also required by the provider's terms.
# GEOCODING_CACHE_MAX_ENTRIES: bounded cache size, oldest evicted first
#   (default 500).
# GEOCODING_MIN_INTERVAL_MS: minimum spacing between ACTUAL outbound requests
#   (default 1100, matching the provider's 1 request/second cap). Cache hits
#   never consume a slot.
# GEOCODING_USER_AGENT: the identifying User-Agent sent to the provider. The
#   provider's terms require a non-generic, application-identifying value.
#
# All of these are optional; the defaults above apply when unset. No secrets.
GEOCODING_PROVIDER="nominatim"
GEOCODING_ENDPOINT="https://nominatim.openstreetmap.org/search"
GEOCODING_TIMEOUT_MS="2500"
GEOCODING_CACHE_TTL_MS="86400000"
GEOCODING_CACHE_MAX_ENTRIES="500"
GEOCODING_MIN_INTERVAL_MS="1100"
GEOCODING_USER_AGENT="Return4me-Kenya-Lost-and-Found-Platform/1.0 (contact@return4me.co.ke)"

# SOCIAL MEDIA AUTO-POSTING INTEGRATION CONFIGURATION
# Telegram Channel Configuration
TELEGRAM_BOT_TOKEN="REPLACE_WITH_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHANNEL_ID="REPLACE_WITH_TELEGRAM_CHANNEL_OR_CHAT_ID"

# Facebook Page Configuration
FACEBOOK_PAGE_ID="REPLACE_WITH_FACEBOOK_PAGE_ID"
FACEBOOK_PAGE_ACCESS_TOKEN="REPLACE_WITH_FACEBOOK_PAGE_ACCESS_TOKEN"

# Twitter/X Configuration
# Create an app at https://developer.twitter.com with OAuth 1.0a "Read and Write"
# permissions, then generate an Access Token & Secret for the account that
# should post (not just the app-level Consumer Key/Secret).
TWITTER_API_KEY="REPLACE_WITH_TWITTER_API_KEY"
TWITTER_API_SECRET="REPLACE_WITH_TWITTER_API_SECRET"
TWITTER_ACCESS_TOKEN="REPLACE_WITH_TWITTER_ACCESS_TOKEN"
TWITTER_ACCESS_TOKEN_SECRET="REPLACE_WITH_TWITTER_ACCESS_TOKEN_SECRET"




